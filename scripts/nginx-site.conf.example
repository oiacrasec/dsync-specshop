# Gateway HTTPS de um projeto (ADR 0043): Nginx no host da VPS, certificado pelo certbot.
# Copie para /etc/nginx/sites-available/<dominio>, troque DOMINIO, BACKEND_PORT e
# FRONTEND_PORT pelos valores do .env da implantação e siga docs/deployment/tutorial.md.
# O certbot --nginx acrescenta o bloco 443 e o redirecionamento de HTTP para HTTPS.

server {
    listen 80;
    listen [::]:80;
    server_name DOMINIO;

    # Foto do Perfil aceita até 2 MB; projetos com uploads maiores ajustam aqui e no backend.
    client_max_body_size 10m;

    # URLs assinadas de mídia levam a assinatura no caminho: não registrar acessos.
    access_log off;

    location /api/ {
        proxy_pass http://127.0.0.1:BACKEND_PORT;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Sempre sobrescritos com os dados reais da conexão: o navegador não escolhe.
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Real-Port $remote_port;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
    }

    location / {
        proxy_pass http://127.0.0.1:FRONTEND_PORT;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
