# Copie para .env e ajuste os valores. Nunca versione o .env.

DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_JWT_SIGNING_KEY=troque-por-outra-chave-longa-e-aleatoria-independente
DJANGO_AUTH_LOGIN_RATE=5/min
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/datasync-core

# Apenas produção
# DJANGO_CSRF_TRUSTED_ORIGINS=https://exemplo.com.br
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000

# Mídia (ADR 0039): filesystem (padrão) ou s3; sempre privada, entregue por URL assinada
# DJANGO_MEDIA_STORAGE=filesystem
# DJANGO_MEDIA_ROOT=/srv/datasync/media
# DJANGO_MEDIA_URL_EXPIRE=300
# Só com DJANGO_MEDIA_STORAGE=s3 (endpoint/addressing para MinIO e compatíveis):
# DJANGO_MEDIA_S3_BUCKET=datasync-media
# DJANGO_MEDIA_S3_REGION=sa-east-1
# DJANGO_MEDIA_S3_PREFIX=media
# DJANGO_MEDIA_S3_ENDPOINT_URL=http://localhost:9000
# DJANGO_MEDIA_S3_ADDRESSING_STYLE=path
# DJANGO_MEDIA_S3_ACCESS_KEY_ID=
# DJANGO_MEDIA_S3_SECRET_ACCESS_KEY=

# Registro de acesso atrás do proxy reverso (obrigatório em produção; ver ADR 0018)
# DJANGO_ACCESS_LOG_IP_HEADER=X-Real-IP
# DJANGO_ACCESS_LOG_PORT_HEADER=X-Real-Port
